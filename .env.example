# Copy to .env and fill in. Never commit .env.

# ---- Server ----
HOST=127.0.0.1
PORT=8000
# Public URL of the site (used for canonical links, sitemap and staff links in emails)
SITE_URL=http://127.0.0.1:8000
# Extra allowed origins for POST requests (comma-separated). The site's own origin is always allowed.
ALLOWED_ORIGINS=
# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0
CLINIC_TIMEZONE=Europe/Belgrade

# ---- Storage ----
DB_PATH=var/quantum.sqlite3

# ---- Content ----
# 1 = show clearly-labelled DEMO specialists (development only, never on the public site)
DEMO_DATA=0
# 1 = show a thin notice that some content is awaiting clinic verification
DRAFT_BANNER=1

# ---- Email ----
# smtp     = send through the SMTP server below
# outbox   = development: write .eml files to var/outbox instead of sending
# disabled = do not send (requests are still stored; status shows "not configured")
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none (local relay only)
SMTP_SECURITY=starttls
SMTP_USERNAME=
# For Gmail / Google Workspace use an App Password (requires 2-Step Verification), not the account password.
SMTP_PASSWORD=
SMTP_TIMEOUT=15
MAIL_FROM=appointments@your-clinic-domain.example
MAIL_FROM_NAME=Quantum Dental Clinic & Implant Center
# Where patient replies go (a monitored clinic inbox). Defaults to MAIL_FROM.
MAIL_REPLY_TO=
# Clinic staff who receive appointment & contact notifications (comma-separated, each sent separately)
CLINIC_NOTIFY_EMAILS=staff1@example.com,staff2@example.com

# ---- Staff dashboard (/admin/) ----
# Long random string (min. 16 chars). Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Signs admin session cookies. Generate the same way. If empty, sessions reset on restart.
SESSION_SECRET=

# ---- Abuse protection ----
BOOKING_RATE_LIMIT=5
CONTACT_RATE_LIMIT=5
RATE_WINDOW_SECONDS=600
